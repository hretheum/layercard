{
  "name": "@layercard/effect-window",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "window — a phone business card whose host phone becomes a window into a deep lit room (scene contract v1.2)",
  "main": "./dist/window.js",
  "module": "./dist/window.js",
  "exports": {
    ".": "./dist/window.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "check": "playwright test -c checks/playwright.config.ts",
    "sheets": "node scripts/sheets.mjs artifacts",
    "video": "node scripts/video.mjs artifacts/window-sequence.mp4 sequence",
    "orbit": "node scripts/video.mjs artifacts/window-orbit.mp4 orbit"
  },
  "peerDependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.10.0",
    "@types/three": "0.187.0",
    "jsqr": "1.4.0",
    "three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
